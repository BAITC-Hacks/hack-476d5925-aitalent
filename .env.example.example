# Скопируйте в .env:  cp .env.example .env
# Все модели работают локально. Аудио и текст совещаний не покидают сервер.

# --- Распознавание речи (faster-whisper) ---
# large-v3-turbo — баланс скорости и качества; на слабом ноутбуке: medium или small
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# --- Диаризация ---
# Пусто = ECAPA (SpeechBrain) + кластеризация, токен не нужен.
# Для pyannote: pip install -r requirements-pyannote.txt и укажите токен Hugging Face.
HF_TOKEN=
# Порог кластеризации ECAPA: меньше — больше говорящих, больше — меньше говорящих
DIAR_THRESHOLD=0.65

# --- Локальная LLM ---
# ollama — Ollama на этой машине; openai_compatible — self-hosted vLLM / NVIDIA NIM on-prem / LM Studio
LLM_BACKEND=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=
LLM_NUM_CTX=16384
# Защита закрытого контура: запросы к нелокальным адресам блокируются
ALLOW_EXTERNAL_LLM=0

# --- Напоминания ---
REMIND_DAYS_BEFORE=1
REMINDER_INTERVAL_SEC=60
